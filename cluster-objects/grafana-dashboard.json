{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping cluster-objects/servicemonitor.yaml. Select the Prometheus instance for this cluster/namespace when importing.",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "KubeStellar Docs - API Requests",
  "uid": "kubestellar-docs-api",
  "description": "Request rate, error rate, and latency for the docs site's instrumented API routes (search, docs-image), sourced from docs_api_requests_total and docs_api_request_duration_seconds (src/lib/metrics.ts). Import-only asset: it does not configure any datasource, exporter, or off-box data flow, and assumes the same optional Prometheus Operator precondition as cluster-objects/servicemonitor.yaml and cluster-objects/prometheusrule.yaml.",
  "tags": ["kubestellar", "docs", "observability"],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route / status class",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(docs_api_requests_total[5m])) by (route, status_class)",
          "legendFormat": "{{route}} - {{status_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx error rate (all instrumented routes)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(docs_api_requests_total{status_class=\"5xx\"}[5m])) / sum(rate(docs_api_requests_total[5m]))",
          "legendFormat": "5xx rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request duration (p50 / p95 / p99) by route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(docs_api_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p50 - {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(docs_api_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p95 - {{route}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(docs_api_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p99 - {{route}}",
          "refId": "C"
        }
      ]
    }
  ]
}
