{
  "_comment": "Static Grafana dashboard definition for the docs site's existing bounded Prometheus metrics (src/lib/metrics.ts, scraped via cluster-objects/servicemonitor.yaml). This file configures no exporter, backend, or credentials, and sends no data anywhere by itself \u2014 it is import-ready JSON for an operator's own Grafana instance once one is confirmed. Panels reference only docs_api_requests_total and docs_api_request_duration_seconds, whose route/status_class labels are drawn from the fixed ApiRoute union and status-class set (bounded cardinality).",
  "title": "KubeStellar Docs \u2014 API Requests",
  "uid": "kubestellar-docs-api",
  "tags": ["kubestellar", "docs"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "API request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(docs_api_requests_total[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx error rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(docs_api_requests_total{status_class=\"5xx\"}[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 request duration by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(docs_api_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests by status class",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(docs_api_requests_total[1h])) by (status_class)",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  }
}
