# Dockerfile.rollout-checker
FROM docker.io/alpine/kubectl:1.37.1@sha256:7b4cc9a9ce0d064cedeb85550266c11f2b32f010ca299525518646261e4d955e

# Install runtime dependencies and OCI CLI (all dependencies hash-pinned)
RUN apk add --no-cache python3 py3-pip bash jq curl gettext \
    && rm -rf /var/cache/apk/* \
    && addgroup -S appgroup && adduser -S -h /home/appuser appuser -G appgroup

COPY requirements.txt /requirements.txt
RUN pip install --break-system-packages --require-hashes --no-cache-dir -r /requirements.txt \
    && rm /requirements.txt

# (Optional) Print versions only during runtime, not build
# ENTRYPOINT ["bash", "-c", "kubectl version --client && oci --version && bash"]

WORKDIR /scripts
RUN chown appuser:appgroup /scripts
USER appuser
ENTRYPOINT ["/bin/bash"]

