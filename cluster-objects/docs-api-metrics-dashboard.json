{
  "title": "KubeStellar Docs — API Self Metrics",
  "description": "Recommendation-only dashboard for the docs site's bounded self-metrics (docs_api_requests_total, docs_api_request_duration_seconds) exposed at /api/metrics (see src/lib/metrics.ts). Import this JSON into a Grafana instance already pointed at a Prometheus that scrapes this deployment via cluster-objects/servicemonitor.yaml; nothing here configures a data source or exporter automatically. No backend is confirmed for this deployment, so this file is not wired into any deployment or CI step other than local lint (scripts/lint-dashboards.sh).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "tags": ["kubestellar", "docs", "self-metrics"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "API request rate by route and status class",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(docs_api_requests_total[5m])) by (route, status_class)",
          "legendFormat": "{{route}} / {{status_class}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx error rate (ratio, instrumented routes)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(docs_api_requests_total{status_class=\"5xx\"}[5m])) / sum(rate(docs_api_requests_total[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request latency by route (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(docs_api_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(docs_api_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(docs_api_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total request volume (5m rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(docs_api_requests_total[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    }
  ]
}
