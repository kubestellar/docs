{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "tsx scripts/generate-shared-config.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:md": "markdownlint-cli2 \"README.md\" \"CONTRIBUTING.md\" \"docs/**/*.{md,mdx}\" \"src/**/*.{md,mdx}\"",
    "check-links": "tsx scripts/check-internal-links.ts",
    "lint:dashboard": "node scripts/lint-dashboard.mjs",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true npm run build",
    "export": "next export",
    "clean": "rm -rf .next out",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --require ./scripts/node-iterator-polyfill.cjs\" vitest run",
    "test:watch": "NODE_OPTIONS=\"$NODE_OPTIONS --require ./scripts/node-iterator-polyfill.cjs\" vitest",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=moderate",
    "update-deps": "npm update && npm audit fix",
    "duplication-check": "node scripts/jscpd-ratchet.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@theguild/remark-mermaid": "^0.3.0",
    "braces": "file:vendor/braces",
    "dotenv": "^18.0.8",
    "framer-motion": "^14.3.0",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.55.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^5.0.5",
    "core-js": "^3.50.0",
    "eslint": "^10",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "markdownlint": "^0.42.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "axios": "^1.16.0",
    "brace-expansion": "^2.1.7",
    "braces": "$braces",
    "dompurify": "^3.4.17",
    "linkify-it": "^6.1.0",
    "follow-redirects": "^1.16.0",
    "katex": "^0.18.2",
    "markdown-it": "^14.3.3",
    "nanoid": "^6.0.1",
    "postcss": "^8.5.24",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.0",
    "uuid": "^14.0.1",
    "minimatch": "3.1.4",
    "lodash-es": "^4.18.1",
    "undici": "^6.22.0"
  }
}
